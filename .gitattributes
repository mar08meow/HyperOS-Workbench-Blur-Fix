# 统一用 LF，避免 shell 脚本 / workflow 在 Linux 上因 CRLF 报 bad interpreter
* text=auto eol=lf

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.list  text eol=lf
*.prop  text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
LICENSE text eol=lf

# 二进制文件不做换行转换
*.apk   binary
*.aar   binary
*.jar   binary
*.png   binary
*.jpg   binary
*.keystore binary
