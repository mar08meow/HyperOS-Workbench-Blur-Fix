<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reasonix.allappsblurfix"
    android:versionCode="2"
    android:versionName="1.1.0">

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:hasCode="true">

        <!-- 设置界面：调整背景模糊强度 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            LibXposed service 提供的 ContentProvider，设置界面通过它跟 LSPosed 通信
            （XposedServiceHelper -> RemotePreferences）。
            正常情况下由 Gradle 的 manifest merger 从 io.github.libxposed:service
            的 AAR 自动合并进来；这里是手工构建，所以必须显式声明。
            authorities 对应 AAR 里的 ${applicationId}.XposedService。
        -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.reasonix.allappsblurfix.XposedService"
            android:exported="true" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="让工作台模式应用列表背景露出窗口实时模糊（动态模糊壁纸），并可调节模糊强度" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
